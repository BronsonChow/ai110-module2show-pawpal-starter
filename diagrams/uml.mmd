classDiagram
    %% PawPal+ initial design
    %% Core actions: add a pet (Owner), schedule a walk / any task (Pet + Task),
    %% see today's tasks (Scheduler -> DailyPlan)

    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +list~Pet~ pets
        +add_pet(Pet pet) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(Task task) None
        +schedule_walk(str time, int duration, str priority) Task
        +get_tasks() list~Task~
    }

    class Task {
        +str title
        +str category
        +int duration_minutes
        +str priority
        +str preferred_time
        +str pet_name
        +str frequency
        +date due_date
        +date last_completed
        +mark_complete(date day) None
        +is_due(date day) bool
        +priority_score() int
    }

    class Scheduler {
        +Owner owner
        +build_daily_plan(date day) DailyPlan
        +sort_by_priority(list~Task~ tasks) list~Task~
        +fits_in_time(Task task, int minutes_left) bool
        +apply_preferences(list~Task~ tasks) list~Task~
    }

    class ScheduledItem {
        +Task task
        +str start_time
        +str reason
    }

    class DailyPlan {
        +date date
        +list~ScheduledItem~ scheduled
        +list~ScheduledItem~ skipped
        +int total_minutes
        +get_todays_tasks() list~ScheduledItem~
        +explain() str
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : reads constraints from
    Scheduler ..> DailyPlan : creates
    DailyPlan "1" --> "*" ScheduledItem : contains
    ScheduledItem --> "1" Task : wraps
    Task ..> Pet : pet_name refers to
