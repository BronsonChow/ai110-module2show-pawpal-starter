classDiagram
    %% PawPal+ design
    %% Core actions: add a pet (Owner), schedule a walk / any task (Pet + Task),
    %% see today's tasks (Scheduler -> DailyPlan)

    class Priority {
        <<enumeration>>
        LOW = 1
        MEDIUM = 2
        HIGH = 3
    }

    class TimeWindow {
        +time start
        +time end
        +minutes() int
    }

    class Owner {
        +str name
        +list~TimeWindow~ available_windows
        +dict preferences
        +list~Pet~ pets
        +add_pet(Pet pet) None
        +get_pet(str name) Pet
        +get_all_tasks() list~Task~
        +total_available_minutes() int
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(Task task) None
        +schedule_walk(time at, int duration, Priority priority) Task
        +get_tasks() list~Task~
    }

    class Task {
        +str title
        +str category
        +int duration_minutes
        +Priority priority
        +time preferred_time
        +str pet_name
        +str frequency
        +date due_date
        +date last_completed
        +mark_complete(date day) None
        +is_completed_on(date day) bool
        +is_due(date day) bool
        +priority_score() int
    }

    class Scheduler {
        +Owner owner
        +get_all_tasks() list~Task~
        +get_due_tasks(date day) list~Task~
        +build_daily_plan(date day) DailyPlan
        +sort_by_priority(list~Task~ tasks) list~Task~
        +apply_preferences(list~Task~ tasks) list~Task~
        +fits_in_time(Task task, list~TimeWindow~ windows, list~tuple~ booked) bool
        +find_slot(Task task, list~TimeWindow~ windows, list~tuple~ booked) time
    }

    class ScheduledItem {
        +Task task
        +time start_time
        +str reason
        +end_time() time
    }

    class DailyPlan {
        +date date
        +list~ScheduledItem~ scheduled
        +list~ScheduledItem~ skipped
        +int total_minutes
        +get_todays_tasks() list~ScheduledItem~
        +explain() str
    }

    Owner "1" --> "*" Pet : owns
    Owner "1" --> "*" TimeWindow : free during
    Pet "1" --> "*" Task : has
    Task --> Priority : uses
    Task ..> Pet : pet_name refers to
    Scheduler --> Owner : reads constraints from
    Scheduler ..> DailyPlan : creates
    DailyPlan "1" --> "*" ScheduledItem : contains
    ScheduledItem --> "1" Task : wraps
