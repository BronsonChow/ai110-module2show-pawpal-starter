classDiagram
    %% PawPal+ design
    %% Core actions: add a pet (Owner), schedule a walk / any task (Pet + Task),
    %% see today's tasks (Scheduler -> DailyPlan)
    %% Recurrence: Scheduler.mark_task_complete -> Owner.get_pet -> Pet.complete_task -> Task.mark_complete

    class Priority {
        <<enumeration>>
        LOW = 1
        MEDIUM = 2
        HIGH = 3
    }

    class TimeWindow {
        +time start
        +time end
        +minutes() int
    }

    class Owner {
        +str name
        +list~TimeWindow~ available_windows
        +dict preferences
        +list~Pet~ pets
        +add_pet(Pet pet) None
        +get_pet(str name) Pet
        +get_all_tasks() list~Task~
        +total_available_minutes() int
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(Task task) None
        +schedule_walk(time at, int duration, Priority priority) Task
        +get_tasks() list~Task~
        +complete_task(Task task, date day) Task
    }

    class Task {
        +str title
        +str category
        +int duration_minutes
        +Priority priority
        +time preferred_time
        +str pet_name
        +str frequency
        +date due_date
        +date last_completed
        +mark_complete(date day) Task
        +is_completed_on(date day) bool
        +is_due(date day) bool
        +priority_score() int
    }

    class Scheduler {
        +Owner owner
        +get_all_tasks() list~Task~
        +get_due_tasks(date day) list~Task~
        +mark_task_complete(Task task, date day) Task
        +build_daily_plan(date day) DailyPlan
        +sort_by_time(list~Task~ tasks) list~Task~
        +filter_tasks(str pet_name, bool completed, date day) list~Task~
        +detect_conflicts(date day) list~str~
        +order_for_booking(list~Task~ tasks) list~Task~
        +fits_in_time(Task task, list~TimeWindow~ windows, list~tuple~ booked) bool
        +find_slot(Task task, list~TimeWindow~ windows, list~tuple~ booked) time
        -_free_gaps(TimeWindow window, list~tuple~ booked) list~tuple~
        -_reason(Task task, time start) str
    }

    class ScheduledItem {
        +Task task
        +time start_time
        +str reason
        +time end_time
    }

    class DailyPlan {
        +date date
        +list~ScheduledItem~ scheduled
        +list~ScheduledItem~ skipped
        +list~str~ warnings
        +int total_minutes
        +get_todays_tasks() list~ScheduledItem~
        +explain() str
    }

    Owner "1" --> "*" Pet : owns
    Owner "1" --> "*" TimeWindow : free during
    Pet "1" --> "*" Task : has
    Task --> Priority : uses
    Task ..> Pet : pet_name refers to
    Task ..> Task : mark_complete creates next occurrence
    Scheduler "1" --> "1" Owner : reads constraints from
    Scheduler ..> Pet : mark_task_complete via complete_task
    Scheduler ..> TimeWindow : books tasks into free gaps
    Scheduler ..> DailyPlan : creates
    Scheduler ..> ScheduledItem : creates
    DailyPlan "1" --> "*" ScheduledItem : contains
    ScheduledItem --> "1" Task : wraps

    class StreamlitApp {
        <<UI app.py>>
    }
    StreamlitApp --> Owner : keeps in session_state
    StreamlitApp ..> Scheduler : filter, sort, detect_conflicts, mark complete, build plan

    note for Task "frequency must be daily, weekly or once.
mark_complete returns None for once tasks."
    note for Owner "get_pet returns None if no pet has that name"
    note for Scheduler "find_slot returns None when no free gap is long enough"
    note for TimeWindow "Raises ValueError if end <= start"

    note for ScheduledItem "end_time is a property: start_time + duration, None if skipped"
